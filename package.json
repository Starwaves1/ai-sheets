{
  "name": "sheets",
  "version": "0.1.0",
  "description": "A small, fast, self-hosted spreadsheet built for humans and AI agents editing together live.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "sheets": "bin/sheets"
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node build.mjs --tests && node --disable-warning=ExperimentalWarning --test 'dist/test/*.js'",
    "start": "node --disable-warning=ExperimentalWarning dist/server.js",
    "e2e": "node build.mjs && node dist/e2e.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3"
  }
}
